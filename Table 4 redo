
/**********************************************************************
***********************************************************************

    TABLE 4 — ANGIOGRAPHY COVERAGE DURING FOLLOW-UP
    ODSOUT VERSION (MERGED CELLS)

***********************************************************************
***********************************************************************/

/* Reuse existing macro variables:
   &goutpath.  Output directory
   &rdat8.     Date suffix
   &font.      Font family
*/

%let COVERAGE_FILE_NUMB = 04_01;
%let COVERAGE_INFILE = &goutpath.angiography_coverage_table.xlsx;

/* Cell border formatting */
%let coverage_border =
    borderstyle=solid
    bordercolor=CXBDBDBD
    borderwidth=0.5pt
;


/* ====================================================================
   1. Import and prepare data
   ==================================================================== */

proc import
    datafile="&COVERAGE_INFILE."
    dbms=xlsx
    out=coverage_import
    replace;
    getnames=yes;
run;

proc sort data=coverage_import out=coverage_sorted;
    by row_order;
run;

data coverage_ods_ready;

    length
        row_kind              $20
        center_display        $60
        investigation_display $80
        time_point_display    $30
        time_window_display   $40
        eligible_display      $30
        angiography_display   $30
        coverage_display_ods  $50
    ;

    set coverage_sorted;

    row_kind = lowcase(strip(row_type));

    if row_kind = "section" then
        center_display = strip(label);

    else if row_kind = "data" then do;

        investigation_display = strip(investigation_print);
        time_point_display    = strip(time_point);
        time_window_display   = strip(time_window);

        /* Handle numeric and character Excel imports */
        eligible_display     = strip(vvalue(eligible_N));
        angiography_display  = strip(vvalue(angiography_n));
        coverage_display_ods = strip(vvalue(coverage_display));

        if eligible_display = "." then
            eligible_display = "";

        if angiography_display = "." then
            angiography_display = "";

        if coverage_display_ods = "." then
            coverage_display_ods = "";

    end;

run;


/* ====================================================================
   2. RTF output settings
   ==================================================================== */

options
    orientation=landscape
    papersize=A4
    leftmargin=0.6in
    rightmargin=0.6in
    topmargin=0.6in
    bottommargin=0.6in
    nodate
    nonumber
;

ods escapechar='^';
ods listing close;

title;
footnote;

ods rtf file=
    "&goutpath.Table_&COVERAGE_FILE_NUMB._ODSOUT_&rdat8..rtf"
    style=styles.journal
    bodytitle;


/* ====================================================================
   3. Construct table using DATA _NULL_ and ODSOUT
   ==================================================================== */

data _null_;

    set coverage_ods_ready end=last;


    /* ---------------------------------------------------------------
       A. Initialize table and headers
       --------------------------------------------------------------- */

    if _N_ = 1 then do;

        dcl odsout obj();

        obj.table_start(
            overrides:
                "width=9.25in
                 frame=box
                 rules=all
                 borderstyle=solid
                 bordercolor=CXBDBDBD
                 borderwidth=0.5pt
                 cellspacing=0
                 cellpadding=2pt"
        );

        obj.head_start();

        obj.row_start(type:"Header");

        obj.format_cell(
            text:"Type of investigation",
            overrides:
                "just=c vjust=m background=CXBDBDBD
                 cellwidth=2.00in fontfamily='&font.'
                 fontweight=bold fontsize=9pt
                 &coverage_border."
        );

        obj.format_cell(
            text:"Time point",
            overrides:
                "just=c vjust=m background=CXBDBDBD
                 cellwidth=1.10in fontfamily='&font.'
                 fontweight=bold fontsize=9pt
                 &coverage_border."
        );

        obj.format_cell(
            text:"Time window post-HTx",
            overrides:
                "just=c vjust=m background=CXBDBDBD
                 cellwidth=2.00in fontfamily='&font.'
                 fontweight=bold fontsize=9pt
                 &coverage_border."
        );

        obj.format_cell(
            text:"Eligible N",
            overrides:
                "just=c vjust=m background=CXBDBDBD
                 cellwidth=1.20in fontfamily='&font.'
                 fontweight=bold fontsize=9pt
                 &coverage_border."
        );

        obj.format_cell(
            text:"Angiography n",
            overrides:
                "just=c vjust=m background=CXBDBDBD
                 cellwidth=1.30in fontfamily='&font.'
                 fontweight=bold fontsize=9pt
                 &coverage_border."
        );

        obj.format_cell(
            text:"Coverage n/N (%)",
            overrides:
                "just=c vjust=m background=CXBDBDBD
                 cellwidth=1.65in fontfamily='&font.'
                 fontweight=bold fontsize=9pt
                 &coverage_border."
        );

        obj.row_end();
        obj.head_end();

    end;


    /* ---------------------------------------------------------------
       B. Center headings
          Merge all six columns
       --------------------------------------------------------------- */

    if row_kind = "section" then do;

        obj.row_start();

        obj.format_cell(
            data:center_display,
            column_span:6,
            overrides:
                "just=c vjust=m background=CXD9D9D9
                 cellwidth=9.25in fontfamily='&font.'
                 fontweight=bold fontsize=9pt
                 &coverage_border."
        );

        obj.row_end();

    end;


    /* ---------------------------------------------------------------
       C. Data rows
       --------------------------------------------------------------- */

    else if row_kind = "data" then do;

        obj.row_start();

        /* -----------------------------------------------------------
           Type of investigation: vertical cell merging

           Early routine follow-up: 4 rows
           Late control:           3 rows
           ----------------------------------------------------------- */

        if strip(investigation_display) =
            "Early routine follow-up" then do;

            obj.format_cell(
                data:investigation_display,
                row_span:4,
                overrides:
                    "just=c vjust=m cellwidth=2.00in
                     fontfamily='&font.'
                     fontweight=bold fontsize=9pt
                     &coverage_border."
            );

        end;

        else if strip(investigation_display) =
            "Late control" then do;

            obj.format_cell(
                data:investigation_display,
                row_span:3,
                overrides:
                    "just=c vjust=m cellwidth=2.00in
                     fontfamily='&font.'
                     fontweight=bold fontsize=9pt
                     &coverage_border."
            );

        end;

        /* For subsequent rows, the first column is occupied
           by the merged cell from the preceding row. */


        /* -----------------------------------------------------------
           Remaining columns
           ----------------------------------------------------------- */

        obj.format_cell(
            data:time_point_display,
            overrides:
                "just=c vjust=m cellwidth=1.10in
                 fontfamily='&font.' fontsize=9pt
                 &coverage_border."
        );

        obj.format_cell(
            data:time_window_display,
            overrides:
                "just=c vjust=m cellwidth=2.00in
                 fontfamily='&font.' fontsize=9pt
                 &coverage_border."
        );

        obj.format_cell(
            data:eligible_display,
            overrides:
                "just=c vjust=m cellwidth=1.20in
                 fontfamily='&font.' fontsize=9pt
                 &coverage_border."
        );

        obj.format_cell(
            data:angiography_display,
            overrides:
                "just=c vjust=m cellwidth=1.30in
                 fontfamily='&font.' fontsize=9pt
                 &coverage_border."
        );

        obj.format_cell(
            data:coverage_display_ods,
            overrides:
                "just=c vjust=m cellwidth=1.65in
                 fontfamily='&font.' fontsize=9pt
                 &coverage_border."
        );

        obj.row_end();

    end;


    /* ---------------------------------------------------------------
       D. Table note
       --------------------------------------------------------------- */

    if last then do;

        obj.row_start();

        obj.format_cell(
            text:
                "Eligible patients were alive, not re-transplanted, and under follow-up at the end of the corresponding time window. Angiography n represents eligible patients with at least one included angiography during the window, including inconclusive angiographies.",
            column_span:6,
            overrides:
                "just=l vjust=t cellwidth=9.25in
                 fontfamily='&font.' fontsize=8pt
                 background=CXFFFFFF
                 &coverage_border."
        );

        obj.row_end();

        obj.table_end();

    end;

run;

ods rtf close;
ods listing;


/**********************************************************************
    END OF TABLE 4 — ODSOUT VERSION
**********************************************************************/
