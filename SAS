/* Find the first variable that exists among a pipe-separated list of candidates.
   The returned value is a SAS name literal when needed. */
%macro pickvar(data=, candidates=, out=);
    %global &out.;
    %let &out.=;

    %local dsid rc i cand pos;
    %let dsid=%sysfunc(open(&data.,i));

    %if &dsid. %then %do;
        %let i=1;

        %do %while(%length(%qscan(%superq(candidates),&i.,|)));
            %let cand=%qscan(%superq(candidates),&i.,|);
            %let pos=%sysfunc(varnum(&dsid.,%superq(cand)));

            %if &pos. > 0 %then %do;
                %let &out.=%sysfunc(nliteral(%superq(cand)));
                %goto pickvar_done;
            %end;

            %let i=%eval(&i.+1);
        %end;

        %pickvar_done:
        %let rc=%sysfunc(close(&dsid.));
    %end;
%mend;


/****************************************************************************************
 * 2. HR tables
 *
 * Expected report-ready columns from R:
 *   Transition
 *   Covariate
 *   HR (95% CI)
 *   p-value
 *
 * Equal constrained effects are put in the same block. HR and p-value cells span the
 * transition rows belonging to that block.
 ****************************************************************************************/

%macro make_hr_table(data=, outbase=, title=, footnote_text=);

    data __hr0;
        length covariate_c transition_c hr_ci_c pval_c $200;
        length block_key $800;
        set &data.;

        covariate_c = strip(vvalue(Covariate));
        transition_c = strip(vvalue(Transition));
        hr_ci_c = strip(vvalue('HR (95% CI)'n));
        pval_c = strip(vvalue('p-value'n));

        /* Same covariate + same HR + same p-value = one constrained-effect block. */
        block_key = catx("|", covariate_c, hr_ci_c, pval_c);
    run;

    proc sort data=__hr0;
        by covariate_c block_key transition_c;
    run;

    proc sql;
        create table __hr_cov_n as
        select covariate_c, count(*) as cov_n
        from __hr0
        group by covariate_c;

        create table __hr_block_n as
        select covariate_c, block_key, count(*) as block_n
        from __hr0
        group by covariate_c, block_key;

        create table __hr as
        select
            a.*,
            b.cov_n,
            c.block_n
        from __hr0 as a
        left join __hr_cov_n as b
            on a.covariate_c=b.covariate_c
        left join __hr_block_n as c
            on a.covariate_c=c.covariate_c
           and a.block_key=c.block_key
        order by a.covariate_c, a.block_key, a.transition_c;
    quit;

    data res.&outbase._DATA;
        set __hr;
    run;

    %make_title(
        outbase=&outbase.,
        title=&title.,
        orientation=portrait
    );

    %output_settings(orientation=portrait);

    ods rtf
        file="&goutpath.Table_&outbase._&rdat8..rtf"
        style=styles.statistical
        bodytitle;

    data _null_;
        set __hr end=last;
        by covariate_c block_key;

        if _n_=1 then do;
            dcl odsout obj();
            obj.table_start();

            obj.head_start();
            obj.row_start(type:"Header");

            obj.format_cell(
                text:"Covariate",
                overrides:"just=c vjust=m background=CXECEDEC cellwidth=4.0cm fontsize=1"
            );
            obj.format_cell(
                text:"Transition",
                overrides:"just=c vjust=m background=CXECEDEC cellwidth=5.0cm fontsize=1"
            );
            obj.format_cell(
                text:"HR (95% CI)",
                overrides:"just=c vjust=m background=CXECEDEC cellwidth=3.5cm fontsize=1"
            );
            obj.format_cell(
                text:"p-value",
                overrides:"just=c vjust=m background=CXECEDEC cellwidth=2.0cm fontsize=1"
            );

            obj.row_end();
            obj.head_end();
        end;

        obj.row_start();

        /* Covariate name spans all its transition-specific rows. */
        if first.covariate_c then
            obj.format_cell(
                data:covariate_c,
                row_span:cov_n,
                overrides:"just=l vjust=m cellwidth=4.0cm fontsize=1 font_weight=bold"
            );

        obj.format_cell(
            data:transition_c,
            overrides:"just=l vjust=t cellwidth=5.0cm fontsize=1"
        );

        /* Identical constrained HR/p-value values span the relevant rows. */
        if first.block_key then do;
            obj.format_cell(
                data:hr_ci_c,
                row_span:block_n,
                overrides:"just=c vjust=m cellwidth=3.5cm fontsize=1"
            );
            obj.format_cell(
                data:pval_c,
                row_span:block_n,
                overrides:"just=c vjust=m cellwidth=2.0cm fontsize=1"
            );
        end;

        obj.row_end();

        if last then do;
            obj.row_start();
            obj.format_cell(
                text:"&footnote_text.",
                column_span:4,
                overrides:"just=l vjust=t fontsize=1 background=CXECEDEC"
            );
            obj.row_end();

            obj.table_end();
        end;
    run;

    ods rtf close;

    proc datasets library=work nolist;
        delete __hr0 __hr_cov_n __hr_block_n __hr;
    quit;

%mend;


