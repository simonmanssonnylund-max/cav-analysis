/****************************************************************************************
 * 3. Angiography coverage by centre
 *
 * Expected columns:
 *   unit, timepoint, window, eligible, angio, no_angio, proportion
 ****************************************************************************************/

data coverage_report;
    length coverage_c $40;
    set coverage_by_center;

    /* Sort 1, 3, 6 year rows numerically within centre. */
    tp_ord = input(compress(vvalue(timepoint),,'kd'), best.);

    coverage_c = cats(
        strip(put(angio,8.)),
        "/",
        strip(put(eligible,8.)),
        " (",
        strip(put(100*proportion,6.1)),
        "%)"
    );
run;

proc sort data=coverage_report;
    by unit tp_ord;
run;

data res.CAV_COVERAGE_CENTER_DATA;
    set coverage_report;
run;

%make_title(
    outbase=CAV_COVERAGE_CENTER,
    title=%str(Coronary angiography coverage by centre and follow-up window),
    orientation=portrait
);

%output_settings(orientation=portrait);

ods rtf
    file="&goutpath.Table_CAV_COVERAGE_CENTER_&rdat8..rtf"
    style=styles.statistical
    bodytitle;

proc report data=coverage_report nowd missing split="|"
    style(report)=[outputwidth=100% fontsize=1]
    style(header)=[background=CXECEDEC just=c vjust=m font_weight=bold fontsize=1]
    style(column)=[vjust=t fontsize=1];

    columns unit timepoint window eligible angio coverage_c;

    define unit /
        group order=data
        "Centre"
        style(column)=[just=l font_weight=bold cellwidth=3.5cm];

    define timepoint /
        display
        "Time point"
        style(column)=[just=c cellwidth=2.0cm];

    define window /
        display
        "Time window post-HTx"
        style(column)=[just=c cellwidth=3.5cm];

    define eligible /
        display
        "Eligible|N"
        style(column)=[just=c cellwidth=2.0cm];

    define angio /
        display
        "Angiography|n"
        style(column)=[just=c cellwidth=2.0cm];

    define coverage_c /
        display
        "Coverage|n/N (%)"
        style(column)=[just=c cellwidth=3.0cm];

    compute after /
        style=[just=l background=CXECEDEC fontsize=1];
        line "Eligible patients were alive at the start of the follow-up window. A real angiography was defined as artificial = FALSE, years > 0, and state 0-3.";
    endcomp;
run;

ods rtf close;


