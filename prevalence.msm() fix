library(msm)

# ============================================================
# 1. LOCAL COPIES OF THE ORIGINAL FUNCTIONS
# ============================================================

ns <- asNamespace("msm")

patch_env <- new.env(parent = ns)

expected_fixed   <- get("expected.msm", envir = ns)
observed_fixed   <- get("observed.msm", envir = ns)
covhist_fixed    <- get("get.covhist", envir = ns)
prevalence_fixed <- msm::prevalence.msm


# ============================================================
# 2. HELPER FOR REPLACING COMPLETE EXPRESSIONS
# ============================================================

replace_expression <- function(fun, pattern, replacement) {

  src <- paste(
    deparse(body(fun), width.cutoff = 500L),
    collapse = "\n"
  )

  matches <- gregexpr(
    pattern,
    src,
    perl = TRUE
  )[[1]]

  stopifnot(
    length(matches) == 1L,
    matches[1] != -1L
  )

  src <- sub(
    pattern,
    replacement,
    src,
    perl = TRUE
  )

  body(fun) <- parse(text = src)[[1]]

  fun
}


# ============================================================
# 3. FIX MISCLASSIFICATION COVARIATES
# ============================================================

expected_fixed <- replace_expression(

  fun = expected_fixed,

  pattern = paste0(
    "ecovs\\s*<-\\s*",
    "if\\s*\\(length\\(ctimes\\)\\s*==\\s*0\\)",
    "\\s*ccovs\\s*else\\s*",
    "ccovs\\[\\[length\\(ccovs\\)\\]\\]"
  ),

  replacement = paste0(
    'ecovs <- ccovs[[findInterval(times[j], ctimes) + 1L]]',
    '[attr(x$data$mf, "covnames.e")]'
  )
)


# ============================================================
# 4. FIX ALIGNMENT OF COVARIATE HISTORIES
# ============================================================

covhist_fixed <- replace_expression(

  fun = covhist_fixed,

  pattern = paste0(
    "change\\.times\\s*<-\\s*split\\(",
    "[^\\n]+"
  ),

  replacement = paste0(
    "change.times <- split(",
    "change.times[keep & !(first | last)], ",
    "factor(subj[keep & !(first | last)], ",
    "levels = unique(subj)), ",
    "drop = FALSE)"
  )
)


# ============================================================
# 5. LINK CORRECTED FUNCTIONS
# ============================================================

environment(expected_fixed)   <- patch_env
environment(observed_fixed)   <- patch_env
environment(covhist_fixed)    <- patch_env
environment(prevalence_fixed) <- patch_env

patch_env$expected.msm <- expected_fixed
patch_env$observed.msm <- observed_fixed
patch_env$get.covhist  <- covhist_fixed


# ============================================================
# 6. CHECK COVARIATE HISTORIES
# ============================================================

ch <- covhist_fixed(fit_constant)

stopifnot(
  length(ch$hist) ==
    length(unique(fit_constant$data$mf[["(subject)"]]))
)


# ============================================================
# 7. CALCULATE PREVALENCES
# ============================================================

cut_time <- 45 / 365.25

times <- sort(unique(c(
  seq(0, 7, by = 0.1),
  cut_time
)))

prev_constant <- prevalence_fixed(
  fit_constant,
  times      = times,
  timezero   = 0,
  covariates = "population",
  interp     = "start",
  ci         = "none"
)


# ============================================================
# 8. RESULTS
# ============================================================

prev_constant$Observed
prev_constant$Expected

prev_constant$`Observed percentages`
prev_constant$`Expected percentages`


# ============================================================
# 9. NUMERICAL CHECKS
# ============================================================

all.equal(
  unname(prev_constant$Observed[, "Total"]),
  unname(prev_constant$Expected[, "Total"]),
  tolerance = 1e-8
)

range(
  rowSums(prev_constant$`Expected percentages`),
  na.rm = TRUE
)
