# Adjusted model: post_cut acts only on transition 1 -> 4.
fit_adj <- msm(
  state ~ years,
  subject = lopnr,
  data = dat,
  qmatrix = Q,
  ematrix = ematrix,
  deathexact = 4,
  obstrue = firstobs,
  covariates = list(
    "1-2" = ~ sex + age + unit + tx_era,
    "1-4" = ~ sex + age + unit + tx_era + post_cut,
    "2-3" = ~ sex + age + unit + tx_era,
    "2-4" = ~ sex + age + unit + tx_era,
    "3-4" = ~ sex + age + unit + tx_era
  ),
  constraint = list(
    sexFemale = c(1, 2, 3, 2, 2),
    age = c(1, 2, 3, 2, 2),
    unitLund = c(1, 2, 1, 2, 2),
    unitStockholm = c(1, 2, 1, 2, 2),
    `tx_era2008-2015` = c(1, 2, 1, 2, 2),
    `tx_era2016-2024` = c(1, 2, 1, 2, 2)
  ),
  method = "BFGS",
  censor = 99,
  censor.states = 1:3
)

# Unadjusted model: no patient covariates, but retain the structural early
