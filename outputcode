windows <- tibble(
  window = factor(
    c("1 year", "3 years", "6 years"),
    levels = c("1 year", "3 years", "6 years")
  ),
  lower = c(0.5, 2, 4),
  upper = c(2, 4, 7),
  target = c(1, 3, 6)
)

angio_window <- dat %>%
  filter(state %in% 1:3) %>%
  mutate(
    window = case_when(
      years >= 0.5 & years < 2 ~ "1 year",
      years >= 2   & years < 4 ~ "3 years",
      years >= 4   & years < 7 ~ "6 years",
      TRUE ~ NA_character_
    )
  ) %>%
  filter(!is.na(window)) %>%
  left_join(
    windows %>% mutate(window = as.character(window)) %>% select(window, target),
    by = "window"
  ) %>%
  group_by(lopnr, window) %>%
  arrange(desc(state), abs(years - target), .by_group = TRUE) %>%
  slice_head(n = 1) %>%
  ungroup() %>%
  transmute(
    lopnr,
    window = factor(window, levels = levels(windows$window)),
    cav_grade = state - 1,
    angio_year = years
  )

# Assumes the final modelling data are already censored appropriately at death,
# re-transplantation, or administrative end of follow-up.
eligible <- crossing(
  lopnr = patient_df$lopnr,
  window = windows$window
) %>%
  left_join(windows, by = "window") %>%
  left_join(patient_df, by = "lopnr") %>%
  filter(followup_years >= lower) %>%
  left_join(angio_window, by = c("lopnr", "window")) %>%
  mutate(conclusive_angio = !is.na(cav_grade))

binom_ci <- function(x, n) {
  if (n == 0) return(c(NA_real_, NA_real_))
  binom.test(x, n)$conf.int
}

table4 <- eligible %>%
  group_by(window) %>%
  summarise(
    eligible_n = n(),
    angio_n = sum(conclusive_angio),
    cav0_n = sum(cav_grade == 0, na.rm = TRUE),
    cav_ge1_n = sum(cav_grade >= 1, na.rm = TRUE),
    cav_ge2_n = sum(cav_grade >= 2, na.rm = TRUE),
    median_angio_year = median(angio_year, na.rm = TRUE),
    q1_angio_year = quantile(angio_year, 0.25, na.rm = TRUE),
    q3_angio_year = quantile(angio_year, 0.75, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  rowwise() %>%
  mutate(
    cav0_pct = 100 * cav0_n / angio_n,
    cav_ge1_pct = 100 * cav_ge1_n / angio_n,
    cav_ge2_pct = 100 * cav_ge2_n / angio_n,
    cav0_LCL = 100 * binom_ci(cav0_n, angio_n)[1],
    cav0_UCL = 100 * binom_ci(cav0_n, angio_n)[2],
    cav_ge1_LCL = 100 * binom_ci(cav_ge1_n, angio_n)[1],
    cav_ge1_UCL = 100 * binom_ci(cav_ge1_n, angio_n)[2],
    cav_ge2_LCL = 100 * binom_ci(cav_ge2_n, angio_n)[1],
    cav_ge2_UCL = 100 * binom_ci(cav_ge2_n, angio_n)[2]
  ) %>%
  ungroup()

