fmt_med_iqr <- function(x, digits = 1) {
  q <- quantile(x, c(0.25, 0.50, 0.75), na.rm = TRUE)
  sprintf(
    paste0("%.", digits, "f (%.", digits, "f; %.", digits, "f)"),
    q[2], q[1], q[3]
  )
}

fmt_med_iqr_range <- function(x, digits = 1) {
  q <- quantile(x, c(0.25, 0.50, 0.75), na.rm = TRUE)
  sprintf(
    paste0(
      "%.", digits, "f (%.", digits, "f; %.", digits,
      "f), range %.", digits, "f-%.", digits, "f"
    ),
    q[2], q[1], q[3], min(x, na.rm = TRUE), max(x, na.rm = TRUE)
  )
}

fmt_mean_sd <- function(x, digits = 1) {
  sprintf(
    paste0("%.", digits, "f (%.", digits, "f)"),
    mean(x, na.rm = TRUE), sd(x, na.rm = TRUE)
  )
}

fmt_n_pct <- function(n, N, digits = 1) {
  sprintf(
    paste0("%d/%d (%.", digits, "f%%)"),
    n, N, 100 * n / N
  )
}

