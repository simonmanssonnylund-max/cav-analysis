# ------------------------------------------------------------------------------
# 7.2 Function defining how the covariate profile changes over time
# ------------------------------------------------------------------------------

# For a requested horizon tmax, create:
#
#   0 ---------------- 21 days ---------------- 1 year ---------------- 2 years ...
#   Early                 After                    After
#   age0                  age0 + cut               age0 + 1
#
# Thus the intensity matrix Q changes at:
#   - 21 days because post_cut changes
#   - each full year because attained age changes
#
# pmatrix.piecewise.msm() then multiplies the transition matrices over
# these intervals.

make_sahl_piecewise_profile <- function(tmax) {

  # 21-day cut point
  cut <- CUT_YEARS


  # Annual times strictly BEFORE the requested endpoint
  annual_cuts <- seq_len(
    floor(tmax)
  )

  annual_cuts <- annual_cuts[
    annual_cuts < tmax
  ]


  # All times at which the intensity matrix changes
  change_times <- sort(
    unique(
      c(
        cut,
        annual_cuts
      )
    )
  )

  # Keep only change points strictly inside (0, tmax)
  change_times <- change_times[
    change_times > 0 &
      change_times < tmax
  ]


  # Beginning of each constant-Q interval
  #
  # Example for tmax = 3:
  #
  # 0, 21 days, 1 year, 2 years
  interval_starts <- c(
    0,
    change_times
  )


  # Covariate values applying during each interval
  covariate_list <- lapply(
    interval_starts,

    function(t) {

      list(

        # Attained age at beginning of interval
        age = age_sahl + t,

        # Fixed patient characteristics
        sex = sex_sahl,
        unit = unit_sahl,
        tx_era = era_sahl,

        # Early mortality intensity applies only during first 21 days
        post_cut = ifelse(
          t < cut,
          "Early",
          "After"
        )
      )
    }
  )


  list(
    times = change_times,
    covariates = covariate_list
  )
}


