extract_q <- function(fit, covs, model_label, period_label) {
  qmatrix.msm(fit, covariates = covs, ci = "delta") %>%
    generics::tidy() %>%
    filter(state != tostate) %>%
    label_msm_matrix() %>%
    mutate(model = model_label, period = period_label)
}

