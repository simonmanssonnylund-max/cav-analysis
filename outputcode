get_qratio <- function(ind1, ind2, covs, comparison, period) {
  z <- qratio.msm(
    fit_adj,
    ind1 = ind1,
    ind2 = ind2,
    covariates = covs,
    ci = "delta"
  )

  tibble(
    comparison = comparison,
    period = period,
    ratio = unname(z["estimate"]),
    SE = unname(z["se"]),
    LCL = unname(z["L"]),
    UCL = unname(z["U"])
  )
}

intensity_ratios <- bind_rows(
  get_qratio(
    c(1, 2), c(1, 4), ref_early,
    "q12 / q14: CAV progression vs death from CAV 0",
    "Early"
  ),
  get_qratio(
    c(1, 2), c(1, 4), ref_after,
    "q12 / q14: CAV progression vs death from CAV 0",
    "After cut"
  ),
  get_qratio(
    c(2, 3), c(2, 4), ref_after,
    "q23 / q24: CAV progression vs death from CAV 1",
    "After cut"
  )
)

