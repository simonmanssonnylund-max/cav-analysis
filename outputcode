# 3. HELPERS / REPRESENTATIVE COVARIATE PROFILE
# ==============================================================================

mode1 <- function(x) {
  x <- x[!is.na(x)]
  names(which.max(table(x)))
}

baseline_df <- dat %>%
  arrange(lopnr, years) %>%
  group_by(lopnr) %>%
  slice_head(n = 1) %>%
  ungroup()

# Continuous covariate: mean. Nominal categorical covariates: modal category.
age_ref <- mean(baseline_df$age, na.rm = TRUE)
sex_ref <- mode1(baseline_df$sex)
unit_ref <- mode1(baseline_df$unit)
era_ref <- mode1(baseline_df$tx_era)

# Convert readable factor levels to the dummy-variable names expected by msm.
make_covlist <- function(age_value,
                         sex_value = sex_ref,
                         unit_value = unit_ref,
                         era_value = era_ref,
                         period_value = "After") {
  nd <- data.frame(
    sex = factor(sex_value, levels = levels(dat$sex)),
    age = age_value,
    unit = factor(unit_value, levels = levels(dat$unit)),
    tx_era = factor(era_value, levels = levels(dat$tx_era)),
    post_cut = factor(period_value, levels = levels(dat$post_cut))
  )
  mm <- model.matrix(~ sex + age + unit + tx_era + post_cut, data = nd)
  vals <- as.numeric(mm[1, -1, drop = TRUE])
  names(vals) <- colnames(mm)[-1]
  as.list(vals)
}

make_postcut_covlist <- function(period_value = "After") {
  nd <- data.frame(
    post_cut = factor(period_value, levels = levels(dat$post_cut))
  )
  mm <- model.matrix(~ post_cut, data = nd)
  vals <- as.numeric(mm[1, -1, drop = TRUE])
  names(vals) <- colnames(mm)[-1]
  as.list(vals)
}

ref_after <- make_covlist(age_ref, period_value = "After")
ref_early <- make_covlist(age_ref, period_value = "Early")
ref_after_unadj <- make_postcut_covlist("After")
ref_early_unadj <- make_postcut_covlist("Early")

# Piecewise profile: age updated yearly; post_cut changes at 21 days.
make_piecewise_profile <- function(tmax,
                                   age0 = age_ref,
                                   sex0 = sex_ref,
                                   unit0 = unit_ref,
                                   era0 = era_ref) {
  annual_cuts <- seq_len(floor(tmax))
  annual_cuts <- annual_cuts[annual_cuts < tmax]
  cuts <- sort(unique(c(CUT_YEARS, annual_cuts)))
  cuts <- cuts[cuts > 0 & cuts < tmax]
  starts <- c(0, cuts)

  covs <- lapply(starts, function(t) {
    make_covlist(
      age_value = age0 + t,
      sex_value = sex0,
      unit_value = unit0,
      era_value = era0,
      period_value = ifelse(t < CUT_YEARS, "Early", "After")
    )
  })

  list(times = cuts, covariates = covs)
}

label_msm_matrix <- function(x) {
  x %>%
    mutate(
      from_state = state_labels[as.character(state)],
      to_state = state_labels[as.character(tostate)],
      transition = paste0(from_state, " -> ", to_state)
    )
}

