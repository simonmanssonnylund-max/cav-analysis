get_qratio <- function(ind1, ind2, covs, comparison, period) {
  z <- qratio.msm(
    fit_adj,
    ind1 = ind1,
    ind2 = ind2,
    covariates = covs,
    ci = "delta"
  )

  tibble(
    comparison = comparison,
    period = period,
    ratio = unname(z["estimate"]),
    SE = unname(z["se"]),
    LCL = unname(z["L"]),
    UCL = unname(z["U"])
  )
}

