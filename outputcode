# ==============================================================================
# SAHLGRENSKA: OBSERVED VS MODELLED PREVALENCE WITH 95% CI
# ==============================================================================

library(msm)
library(dplyr)
library(tidyr)
library(purrr)
library(ggplot2)
library(ggh4x)
library(parallel)
library(scales)


# ==============================================================================
# 1. SETTINGS
# ==============================================================================

prev_times <- seq(0, 7, by = 0.05)

# Number of simulations from the asymptotic distribution of the MLEs
B <- 1000

# Use several cores, but leave two free.
# Increase 32 if the server has many cores and plenty of RAM.
ncores <- min(
  32L,
  max(1L, parallel::detectCores() - 2L)
)

ncores

state_labels <- c(
  "1" = "CAV 0",
  "2" = "CAV 1",
  "3" = "CAV >=2",
  "4" = "Death"
)


# ==============================================================================
# 2. IDENTIFY SAHLGRENSKA PATIENTS
# ==============================================================================

# Sahlgrenska is the reference category for unit in fit_adj:
# the level other than Lund and Stockholm.
sahl_level <- setdiff(
  levels(test18_pw$unit),
  c("Lund", "Stockholm")
)[1]

sahl_level


# Subject order actually used in fit_adj
mf_adj <- model.frame(fit_adj)

model_ids <- unique(
  mf_adj[["(subject)"]]
)


# Sahlgrenska subjects, preserving the model subject order
sahl_ids <- model_ids[
  model_ids %in%
    unique(
      test18_pw$lopnr[
        test18_pw$unit == sahl_level
      ]
    )
]

length(sahl_ids)


# ==============================================================================
# 3. SUBJECT-SPECIFIC CENSORING TIMES
# ==============================================================================

# Assumes your censoring data are:
#   cens_df$lopnr
#   cens_df$censtime
#
# If your object has another name, only change these two references.

cen_sahl <- cens_df$censtime[
  match(sahl_ids, cens_df$lopnr)
]

stopifnot(
  length(cen_sahl) == length(sahl_ids),
  !anyNA(cen_sahl)
)


# ==============================================================================
# 4. POINT ESTIMATES OF OBSERVED AND MODELLED PREVALENCE
# ==============================================================================

# ci = "none" is deliberate.
# We calculate the normal-simulation CI manually below so that subset=sahl_ids
# is retained throughout the calculations.

prev_sahl <- prevalence.msm(
  fit_adj,
  times = prev_times,
  subset = sahl_ids,
  covariates = "population",
  censtime = cen_sahl,
  interp = "start",
  ci = "none"
)


# Extract the two percentage matrices
obs_pct <- prev_sahl[["Observed percentages"]]
exp_pct <- prev_sahl[["Expected percentages"]]


# ==============================================================================
# 5. OBTAIN THE SAHLGRENSKA-SPECIFIC RISK MATRIX
# ==============================================================================

# observed.msm() constructs the same risk-set information used internally by
# prevalence.msm(), now explicitly restricted to Sahlgrenska.

obs_sahl <- msm:::observed.msm(
  fit_adj,
  times = prev_times,
  interp = "start",
  censtime = cen_sahl,
  subset = sahl_ids
)

risk_sahl <- obs_sahl$risk


# ==============================================================================
# 6. NORMAL-SIMULATION CONFIDENCE INTERVALS IN PARALLEL
# ==============================================================================

# This is NOT a patient bootstrap.
#
# Each simulation draws a parameter vector from the asymptotic multivariate
# normal distribution of the estimated model parameters and recalculates
# expected prevalence.
#
# msm:::normboot.msm() itself is sequential, so we split the simulations
# across several processes.

# Divide B simulations approximately evenly across cores
B_chunks <- rep(
  B %/% ncores,
  ncores
)

if (B %% ncores > 0) {
  B_chunks[seq_len(B %% ncores)] <-
    B_chunks[seq_len(B %% ncores)] + 1
}

# Remove any zero-size chunks
B_chunks <- B_chunks[B_chunks > 0]

B_chunks
sum(B_chunks)


# Reproducible independent random-number streams across forked workers
RNGkind("L'Ecuyer-CMRG")
set.seed(1234)


prev_chunks <- parallel::mclapply(
  B_chunks,

  FUN = function(B_this) {

    msm:::normboot.msm(
      fit_adj,

      stat = function(fit_sim) {

        msm:::expected.msm(
          fit_sim,
          times = prev_times,
          covariates = "population",
          risk = risk_sahl,
          subset = sahl_ids,
          ci = "none"
        )[["Expected percentages"]]

      },

      B = B_this
    )
  },

  mc.cores = length(B_chunks),
  mc.set.seed = TRUE,
  mc.preschedule = TRUE
)


# Each worker returns a list of matrices.
# Combine them into one list of B simulated prevalence matrices.
prev_sim <- do.call(
  c,
  prev_chunks
)

stopifnot(
  length(prev_sim) == B
)


# ==============================================================================
# 7. CALCULATE 95% CONFIDENCE LIMITS
# ==============================================================================

nstates <- fit_adj$qmodel$nstates


# Each element of prev_sim is:
#
#       time x state
#
# Stack them into:
#
#       time x state x simulation

prev_array <- array(
  unlist(
    prev_sim,
    use.names = FALSE
  ),
  dim = c(
    length(prev_times),
    nstates,
    B
  )
)


# Calculate 2.5th and 97.5th percentiles for every time/state combination.
#
# Result dimensions:
#
#       CI bound x time x state

prev_ci <- apply(
  prev_array,
  MARGIN = c(1, 2),
  FUN = quantile,
  probs = c(0.025, 0.975),
  na.rm = TRUE
)


# ==============================================================================
# 8. CREATE CLEAN DATA FRAME FOR GGPLOT
# ==============================================================================

prev_sahl_df <- purrr::map_dfr(
  seq_len(nstates),

  function(s) {

    tibble(
      time = prev_times,

      state = s,

      state_name =
        state_labels[as.character(s)],

      observed =
        obs_pct[, s],

      modelled =
        exp_pct[, s],

      conf.low =
        prev_ci[1, , s],

      conf.high =
        prev_ci[2, , s]
    )
  }
) %>%
  mutate(
    state_name = factor(
      state_name,
      levels = c(
        "CAV 0",
        "CAV 1",
        "CAV >=2",
        "Death"
      )
    )
  )


# Quick checks
head(prev_sahl_df)

prev_sahl_df %>%
  group_by(state_name) %>%
  summarise(
    max_observed = max(observed, na.rm = TRUE),
    max_modelled = max(modelled, na.rm = TRUE),
    max_upper_CI = max(conf.high, na.rm = TRUE)
  )


# ==============================================================================
# 9. PUBLICATION-READY PREVALENCE FIGURE
# ==============================================================================

p_prev_sahl <- ggplot(
  prev_sahl_df,
  aes(x = time)
) +

  # --------------------------------------------------------------------------
  # 95% CI for modelled prevalence
  # --------------------------------------------------------------------------

  geom_ribbon(
    aes(
