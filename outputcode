# ------------------------------------------------------------------------------
# 7.4 Function to calculate P(0,t) with 95% CIs
# ------------------------------------------------------------------------------

# CIs are obtained by simulation from the asymptotic multivariate normal
# distribution of the fitted parameters.
#
# This is NOT a patient bootstrap.

B_CI <- 1000


get_P_sahl <- function(t) {

  # Covariate history appropriate for this particular horizon
  pw <- make_sahl_piecewise_profile(t)


  # pmatrix.piecewise.msm() obtains the fitted Q separately for each interval
  # and calculates:
  #
  # P(0,t) = P1 %*% P2 %*% ... %*% Pk
  #
  # Thus both the early q14 intensity and subsequent age-related changes
  # in the intensities are incorporated.

  P <- pmatrix.piecewise.msm(
    fit_adj,
    t1 = 0,
    t2 = t,
    times = pw$times,
    covariates = pw$covariates,
    ci = "normal",
    cl = 0.95,
    B = B_CI
  )


  # pmatrix.piecewise.msm() returns:
  #   P$estimates = point estimates
  #   P$L         = lower CI
  #   P$U         = upper CI

  nstates <- nrow(
    P$estimates
  )


  # as.vector(matrix) runs down columns, so this index structure
  # deliberately varies 'state' first.
  ind <- expand.grid(
    state = seq_len(nstates),
    tostate = seq_len(nstates)
  )


  tibble(
    year = t,

    state = ind$state,
    tostate = ind$tostate,

    estimate = as.vector(
      P$estimates
    ),

    conf.low = as.vector(
      P$L
    ),

    conf.high = as.vector(
      P$U
    )
  ) %>%

    mutate(
      from_state =
        state_labels[
          as.character(state)
        ],

      to_state =
        state_labels[
          as.character(tostate)
        ],

      transition = paste0(
        from_state,
        " -> ",
        to_state
      )
    )
}


