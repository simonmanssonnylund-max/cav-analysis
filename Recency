library(dplyr)
library(tidyr)

# ==============================================================================
# 1. SETTINGS AND PREPARE DATA
# ==============================================================================

TIME_MAX <- 7
SAHL_LEVEL <- "Göteborg"

dat <- test %>%
  ungroup() %>%
  mutate(
    lopnr = as.character(lopnr),
    years = as.numeric(years),
    state = as.integer(as.character(state))
  )

# If available, use the original artificial-row indicator.
# Otherwise assume artificial observations are already coded state = 99.
dat <- dat %>%
  mutate(
    is_artificial = if ("artificial" %in% names(dat)) {
      coalesce(as.logical(artificial), FALSE)
    } else {
      FALSE
    }
  )

dat_sahl <- dat %>%
  filter(as.character(unit) == SAHL_LEVEL)

# ==============================================================================
# 2. RECONSTRUCT END OF FOLLOW-UP
# ==============================================================================

# Prefer the existing patient-level follow-up time.
# If absent, the final observation time is used instead.

if (!"obs_yrs" %in% names(dat_sahl)) {

  dat_sahl <- dat_sahl %>%
    group_by(lopnr) %>%
    mutate(obs_yrs = max(years, na.rm = TRUE)) %>%
    ungroup()

}

# ==============================================================================
# 3. RECONSTRUCT CONCLUSIVE CAV ASSESSMENT TIMES
# ==============================================================================

# State coding:
# 1, 2, 3 = conclusive CAV states
# 4       = death/re-transplantation
# 99      = alive, CAV state unknown
#
# Do not use statemax here: that variable has been carried forward.

assessment_times <- dat_sahl %>%
  filter(
    years > 0,
    years <= TIME_MAX,
    state %in% 1:3,
    !is_artificial
  ) %>%
  transmute(
    lopnr,
    exam_year = years
  ) %>%
  distinct() %>%
  arrange(lopnr, exam_year)

# ==============================================================================
# 4. RECONSTRUCT PATIENT FOLLOW-UP AND ABSORBING EVENTS
# ==============================================================================

recency_patients <- dat_sahl %>%
  group_by(lopnr) %>%
  summarise(
    obs_yrs = max(obs_yrs, na.rm = TRUE),

    death_time = if (any(state == 4, na.rm = TRUE)) {
      min(years[state == 4], na.rm = TRUE)
    } else {
      Inf
    },

    .groups = "drop"
  ) %>%
  mutate(
    end_time = pmin(obs_yrs, TIME_MAX)
  )

stopifnot(
  nrow(recency_patients) > 0,
  all(is.finite(recency_patients$end_time)),
  all(recency_patients$end_time >= 0)
)

# ==============================================================================
# 5. TIME SINCE LAST ASSESSMENT FOR EACH AT-RISK PATIENT
# ==============================================================================

recency_patient_times <- tidyr::crossing(
  recency_patients,
  time = seq(0, TIME_MAX, by = 0.05)
) %>%
  filter(
    time <= end_time,
    time < death_time
  ) %>%
  left_join(
    assessment_times,
    by = join_by(lopnr, closest(time >= exam_year))
  ) %>%
  mutate(
    # Initial assumed CAV-free state at transplantation
    last_assessment = coalesce(exam_year, 0),

    years_since_assessment = time - last_assessment,

    # Patient has never had a conclusive post-transplant angiography
    baseline_only = is.na(exam_year)
  )

# ==============================================================================
# 6. MEDIAN, IQR AND BASELINE-ONLY PROPORTION
# ==============================================================================

recency_summary <- recency_patient_times %>%
  group_by(time) %>%
  summarise(
    n_at_risk = n(),

    median_recency = median(years_since_assessment),

    q25 = quantile(
      years_since_assessment, 0.25,
      names = FALSE
    ),

    q75 = quantile(
      years_since_assessment, 0.75,
      names = FALSE
    ),

    pct_baseline_only = 100 * mean(baseline_only),

    .groups = "drop"
  )

# ==============================================================================
# 7. INSPECT SELECTED TIMES
# ==============================================================================

recency_summary %>%
  filter(round(time, 2) %in% c(1, 3, 6, 7))
# ====================================================================
# 5. Add recency to the prevalence figure
# ====================================================================

recency_plot <- recency_summary %>%
  mutate(
    median_scaled = 100 * median_recency / TIME_MAX,
    q25_scaled = 100 * q25 / TIME_MAX,
    q75_scaled = 100 * q75 / TIME_MAX
  )

p_prev_sahl <- ggplot() +

  # IQR band, drawn behind the prevalence curves
  geom_ribbon(
    data = recency_plot,
    aes(
      x = time,
      ymin = q25_scaled,
      ymax = q75_scaled
    ),
    fill = "grey60",
    alpha = 0.18
  ) +

  # Median time since last CAV ascertainment
  geom_line(
    data = recency_plot,
    aes(x = time, y = median_scaled),
    colour = "grey35",
    linewidth = 0.6
  ) +

  # Existing prevalence curves
  geom_line(
    data = prev_sahl_long,
    aes(
      x = time,
      y = prevalence,
      colour = series,
      linetype = series
    ),
    linewidth = 0.9
  ) +

  facet_wrap(~ state_name, ncol = 2) +

  scale_x_continuous(
    breaks = 0:7,
    limits = c(0, 7),
    expand = expansion(mult = c(0, 0.01))
  ) +

  scale_y_continuous(
    breaks = seq(0, 100, 20),
    limits = c(0, 100),
    expand = expansion(mult = c(0, 0.02)),

    sec.axis = sec_axis(
      ~ . * TIME_MAX / 100,
      name = "Years since last CAV ascertainment",
      breaks = 0:7
    )
  ) +

  scale_colour_manual(
    values = c(
      "Observed" = "#1F4E79",
      "Model-predicted" = "#A23B3B",
      "Modelled" = "#A23B3B"
    )
  ) +

  scale_linetype_manual(
    values = c(
      "Observed" = "solid",
      "Model-predicted" = "dashed",
      "Modelled" = "dashed"
    )
  ) +

  labs(
    x = "Years after heart transplantation",
    y = "Prevalence (%)",
    colour = NULL,
    linetype = NULL,
    caption = paste(
      "Grey line: median time since last CAV ascertainment;",
      "grey band: interquartile range.",
      "Baseline CAV status is assumed known at transplantation."
    )
  ) +

  theme_minimal(
    base_size = 11,
    base_family = "Aptos"
  ) +

  theme(
    panel.grid.minor = element_blank(),

    panel.grid.major.x = element_line(
      linewidth = 0.25, colour = "grey85"
    ),
    panel.grid.major.y = element_line(
      linewidth = 0.25, colour = "grey85"
    ),

    panel.border = element_rect(
      fill = NA, colour = "grey40", linewidth = 0.5
    ),

    strip.background = element_rect(
      fill = "white", colour = "grey40", linewidth = 0.5
    ),
    strip.text = element_text(
      face = "bold", size = 11
    ),

    axis.title = element_text(size = 11),
    axis.text = element_text(size = 10),

    legend.position = "bottom",
    legend.key.width = grid::unit(1.5, "cm"),

    plot.caption = element_text(
      size = 9, hjust = 0
    )
  )

p_prev_sahl
